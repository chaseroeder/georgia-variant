# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored, so your keys never get committed.
# Every key is optional: if one is missing, the site shows sample data.

# Public URL of the deployed site (used for SEO / Open Graph links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2: FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Phase 2: Financial Modeling Prep (free plan: 250 calls/day)
# Sign up: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# How often to refresh quotes while the market is open, in minutes.
# 15 is fine if your plan allows batch quotes. If you see rate-limit
# warnings in the terminal, raise it (e.g. 45).
FMP_REFRESH_MINUTES=15

# ── Email (Resend, free plan: up to 1,000 subscribers) ──
# Sign up: https://resend.com → API Keys
RESEND_API_KEY=
# Resend dashboard → Audience → Segments → copy the segment's ID
RESEND_SEGMENT_ID=
# Sender. The domain must be verified in Resend (Domains → Add Domain).
# For a quick test before you own a domain: "The Georgia Variant <onboarding@resend.dev>"
# (that address can only email YOUR OWN Resend login email).
EMAIL_FROM=
# Optional: where replies go
EMAIL_REPLY_TO=

# ── Sending & cron ──
# Any long random string. Protects /api/send-issue. Vercel sends it automatically to cron jobs.
CRON_SECRET=
# The daily 7 a.m. ET automatic send. Leave "false" until you're ready.
CRON_ENABLED=false
